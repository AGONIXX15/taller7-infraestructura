apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: taller7-app
type: Opaque
stringData:
  POSTGRES_DB: items
  POSTGRES_USER: taller7
  POSTGRES_PASSWORD: cambiar
  SPRING_DATASOURCE_USERNAME: taller7
  SPRING_DATASOURCE_PASSWORD: cambiar
  SPRING_DATASOURCE_URL: jdbc:postgresql://db.taller7-app.svc.cluster.local:5432/items
